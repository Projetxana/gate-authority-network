{
  "name": "gate-authority-network-developer-preview",
  "version": "0.1.0-dev.2",
  "private": true,
  "type": "module",
  "description": "GATE Authority Verification Network developer preview",
  "workspaces": [
    "packages/sdk",
    "packages/mcp",
    "packages/http",
    "packages/x402",
    "packages/authzen",
    "packages/a2a",
    "packages/ap2",
    "packages/ssf"
  ],
  "scripts": {
    "demo": "node examples/sdk-quickstart.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs test/integration/*.test.mjs",
    "check": "find . -name '*.mjs' -not -path './node_modules/*' -print0 | xargs -0 -n1 node --check",
    "pack:check": "npm pack --dry-run --workspace @gate-avn/sdk && npm pack --dry-run --workspace @gate-avn/mcp && npm pack --dry-run --workspace @gate-avn/http && npm pack --dry-run --workspace @gate-avn/x402 && npm pack --dry-run --workspace @gate-avn/authzen && npm pack --dry-run --workspace @gate-avn/a2a && npm pack --dry-run --workspace @gate-avn/ap2 && npm pack --dry-run --workspace @gate-avn/ssf",
    "publish:github": "./scripts/publish-github.sh",
    "smoke:mcp:hosted": "node scripts/run-hosted-mcp-verified-effect.mjs",
    "smoke:http:hosted": "node scripts/run-hosted-http-verified-effect.mjs",
    "smoke:x402:hosted": "node scripts/run-hosted-x402-verified-effect.mjs",
    "smoke:authzen:hosted": "node scripts/run-hosted-authzen-verified-effect.mjs",
    "smoke:a2a:hosted": "node scripts/run-hosted-a2a-verified-effect.mjs",
    "smoke:ap2:hosted": "node scripts/run-hosted-ap2-verified-effect.mjs",
    "smoke:ssf:caep": "node scripts/run-signed-ssf-caep-smoke.mjs",
    "smoke:ssf:hosted": "node scripts/run-hosted-ssf-ingestion.mjs",
    "smoke:ssf:canonical": "node scripts/run-canonical-ssf-project-bridge.mjs",
    "smoke:ssf:independent": "node scripts/run-independent-caepdev-interop.mjs",
    "example:ssf:byo": "node examples/ssf-byo-receiver.mjs",
    "ci:stage16": "node scripts/validate-stage16-reproducibility.mjs",
    "smoke:mcp:subscription-authority": "bash scripts/run-mcp-subscription-authority-fixture.sh",
    "smoke:mcp:subscription-live": "node scripts/run-live-gate-mcp-subscription.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.6"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@x402/core": "2.24.0"
  }
}
